; Engine configuration file.
; Godot 4.x — portrait mobile bootstrap. 720×1280 is the minimum viewport.

config_version=5

[application]

config/name="Orbit Flip"
run/main_scene="res://app/bootstrap/bootstrap.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/svg/branding/app_icon.svg"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
